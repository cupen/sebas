{# Minimal viable sebas config rendered by the ansible role.
   Only sections that need a default for the WebUI-only deploy are rendered;
   everything else is left for `sebas_config_extra` (appended verbatim) or
   the operator to add later. The watchdog channel secret (SEBAS_CORE_SECRET)
   is owned by the watchdog at runtime — it never appears here. #}

[watchdog.storage]
data_dir = "{{ sebas_data_dir }}"

[watchdog.webui]
host = "{{ sebas_webui_host }}"
port = {{ sebas_webui_port }}

[feishu]
enabled = false
{% if sebas_config_extra | length > 0 %}

# --- operator-supplied extras (sebas_config_extra) ---------------------
{{ sebas_config_extra }}
{% endif %}
