target/
**/*.rs.bk
Cargo.lock.bak
config.toml
.xkeeper.toml
.zcode/


# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
.beads/interactions.jsonl
.claude/worktrees
.worktree/
logs/
.codebase-memory/
# sebas 本地运行时状态（cookies/downloads/usage jsonl 等）
/state/
*.xml

# ansible: host_vars may carry vault-encrypted secrets / per-host creds;
# keep the role/inventory checked in, host-specific overrides out.
.ansible/host_vars/

# 根目录 cargo 产物二进制;不带锚点会把 .ansible/roles/sebas/ 等同名目录一并忽略
/sebas

.e2e/
node_modules/
sebas-webui/frontend/dist/
gui-test-screenshots
config/core.secret
__pycache__/
*.egg-info/
config/config.prod.toml
target-qa/
target-qa-r5/
.beads.gate.lock
__no_overlay__.json

# 套件运行报告与验证产物（add-testsuite-report）：report-<suite>.html 固定
# 路径覆盖写，属本地运行产物；`.artifacts/verify/*.log` 是既有运行日志同理。
/.artifacts/
