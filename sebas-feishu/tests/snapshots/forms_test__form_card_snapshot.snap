---
source: feishu/tests/forms_test.rs
expression: card
---
schema: "2.0"
header:
  title:
    content: 备忘
    tag: plain_text
  template: blue
body:
  elements:
    - tag: form
      name: note
      elements:
        - content: "**标题** *"
          tag: markdown
        - default_value: 旧标题
          name: title
          placeholder:
            content: 标题
            tag: plain_text
          required: true
          tag: input
          width: fill
        - content: "**内容**"
          tag: markdown
        - name: body
          placeholder:
            content: 正文
            tag: plain_text
          tag: input
          width: fill
        - content: "**优先级** *"
          tag: markdown
        - name: priority
          options:
            - text:
                content: P0
                tag: plain_text
              value: p0
            - text:
                content: P1
                tag: plain_text
              value: p1
          placeholder:
            content: 请选择
            tag: plain_text
          required: true
          tag: select_static
          type: default
          width: fill
        - behaviors:
            - type: callback
              value:
                form: note
                id: n1
                op: submit
          form_action_type: submit
          name: note_submit
          tag: button
          text:
            content: 提交
            tag: plain_text
          type: primary
