[feishu]
app_id = ""
app_secret = ""
# owner_id 单用户鉴权（你的 open_id，ou_ 开头）。
# 决策（sebas-nya）：可选，偏离 spec §6.1 的必填 —— 留空 = 不过滤发送者，
# 任何能给 bot 发消息的飞书用户都可驱动本机 claude，启动时会有 warn 提示。
# 强烈建议填上：open_id 可在飞书开放平台或 bot 收到的消息事件里查到。
# owner_id = "ou_xxx"
# 启动时发给每个恢复会话的消息（空 = 不发）
# hello_msg = "你好，我又回来了"

# env 覆盖（spec §6.3，优先级高于本文件）：
#   SEBAS_FEISHU_APP_ID / SEBAS_FEISHU_APP_SECRET / SEBAS_LOG_LEVEL

# Claude Code integration: the bridge binary built from this workspace
# (member crate `acp-claude-bridge/`). It spawns `claude --print --input-format
# stream-json --output-format stream-json` under the hood and speaks ACP to
# sebas. Default path works for `cargo run` / `cargo build` from this repo;
# install the binary to /usr/local/bin for production.
[acp.claude]
path = "./target/debug/claude-acp-bridge"
args = []

# Optional: router, card, media, log sections all have defaults.
# See docs/superpowers/specs/2026-07-26-sebas-design.md §6.2 for full list.
