[feishu]
app_id = ""
app_secret = ""
# owner_id = "ou_xxx"        # 单用户鉴权；留空 = 不过滤发送者（启动时 warn）
# hello_msg = "你好，我又回来了"   # 启动时发给每个恢复会话

# Agent 接入（[acp.agents.<name>]）：
#   driver = "claude"  → Claude Code CLI（stream-json + control protocol）
#   driver = "acp"     → 任意支持 Agent Client Protocol v1 的 CLI（opencode/gemini…）
[acp.agents.claude]
driver = "claude"
# 附加 CLI 参数必须用键值形式（`--flag value`；fix-webui-qa-defects 6.2）。
# 位置参数（如 "thinking"）无法表达进子进程 argv——解析期直接报错，不再
# 静默丢弃。
# args = ["--scenario", "thinking"]

# [acp.agents.opencode]
# driver = "acp"
# command = ["opencode", "acp"]

# 卡片流（全部可选，契约见 openspec/specs/feishu-cards/spec.md）
# [card]
# max_user_text_chars = 4000
# max_tool_output_chars = 0    # 0 = 不输出 tool call 结果内容
# fold_long_output = true
# thinking = "show"

# LLM provider 网关（三协议纯透传：Anthropic / OpenAI chat-completions /
# OpenAI Responses，契约见 openspec/specs/router-core/spec.md）。router 只以
# 独立进程运行：`sebas router -c <path>`（手工）或 watchdog 托管
# [service.router]（拉起同一入口的子进程）；`--debug`
# 注入内置 test provider（固定文字+回显，不拨上游，跳过鉴权）。
#
# provider 写顶层 [provider.<name>]，名称即 preset
# （anthropic/openai/deepseek/kimi/glm/minimax/ark/dashscope/gemini）。
# preset 的 base_url / models 跟随代码内置表：派生条目显式写这些字段即
# 配置错误；用户只配密钥（api_key / api_key_env）。统一槽 base_url_openai
# 已移除——三槽位为 base_url_anthropic / base_url_openai_chat /
# base_url_openai_responses，缺槽 = 该协议 400。
# [router]
# listen = "127.0.0.1:8787"     # 独立进程（含 watchdog 托管的 router 子进程）都读这里
# default_provider = "deepseek" # 无 model 请求（如 GET /v1/models）的兜底
# auth_token = ["sk-local-dev"] # 不配置 = 不校验下游 token（启动时 warn）
#
# 用量库（persist-router-usage）：router 自有的 SQLite 文件，一行一条记录
# （时间戳/协议/模型/provider/上游模型/状态/延迟/ttft/四类 token 计数/error；
# key 字段恒空——无 per-key 归属）。缺省落在状态目录下（`usage.db`，
# SEBAS_ROUTER_USAGE_DB 可覆盖）；router 是唯一写入者，且**不打开** core 的
# 状态库。
# 旧的 `usage_file`（NDJSON）键已删除——残留会以未知键报错。
# usage_db = "~/.sebas/usage.db"
#
# 保留期（双闸，后台定期清理；两闸都设 0 = 不清理，库会无限增长）：
#   usage_retention_days       时间闸，默认 30（保守值）；0 = 关闸
#   usage_max_rows             行数闸，默认 200000；0 = 关闸
#   usage_prune_interval_secs  清理间隔，默认 3600（秒）；0 = 不跑后台清理
# 清理动作写 INFO 日志（aged_pruned / excess_pruned 计数），数据不会悄悄消失。
# usage_retention_days = 30
# usage_max_rows = 200000
# usage_prune_interval_secs = 3600
#
# 直接查库（不新增导出 CLI；非标准查询手写 SQL 即可）：
#   sqlite3 ~/.sebas/usage.db \
#     "SELECT ts, provider, model, status, input_tokens, output_tokens \
#        FROM usage_records WHERE model = 'claude-sonnet-4' ORDER BY id DESC LIMIT 20"
#   sqlite3 ~/.sebas/usage.db \
#     "SELECT provider, model, COUNT(*), SUM(output_tokens) \
#        FROM usage_records GROUP BY provider, model ORDER BY 3 DESC"
#
# [provider.anthropic]
# # api_key = "..."    # 明文可落 overlay（WebUI/卡片写入）；config.toml 建议 env
#
# [provider.deepseek]
#
# 自定义 provider：三个槽位至少配一个。
# [provider.my-gateway]
# base_url_anthropic = "https://my-gateway.example/anthropic"
# base_url_openai_chat = "https://my-gateway.example/v1"
# base_url_openai_responses = "https://my-gateway.example/v1"
# api_key_env = "MY_GATEWAY_KEY"
#
# 路由表：model（可含 glob，键加引号）→ provider 数组，顺序 = 优先级。
# "deepseek-*" = ["deepseek", "ark"]

# watchdog 托管的服务开关。不写 = core 恒启动、webui 开、router 关；
# 在 WebUI 服务页启停（core 除外）会持久化到 ~/.sebas/services.json，优先于此处。
# [service.webui]     # 默认启用；端口冲突自动降级 degraded
# host = "127.0.0.1"
# port = 9797
# auth = true          # 登录鉴权开关。开启（默认）= 全部 /api 与 /ws 需登录：
#                      #   零用户首启走 WebUI 设置页引导建 root（loopback），
#                      #   或事先用 SEBAS_WEBUI_USER + SEBAS_WEBUI_PASSWORD
#                      #   环境变量 / `sebas auth add <name>`
#                      #   建户（用户库默认 ~/.sebas/auth.db，env
#                      #   SEBAS_WEBUI_AUTH_DB 覆盖）。
#                      # false = 全路由免登录（仅测试用）；host 非 loopback
#                      # 时无论开关与否都拒绝启动（安全门）。
#
# core 恒启动（会话核心，无开关）。[service.core] 只配置通道路径：
# [service.core]
# channel_path = "~/.sebas/core.sock"   # 缺省 XDG_RUNTIME_DIR/sebas/core.sock
# secret_file = "~/.sebas/core.secret"  # 缺省 <config 目录>/core.secret
#
# [service.router]    # router 受管子进程；watchdog --debug 强制启用
# enabled = true

# env 覆盖（优先级高于本文件）：SEBAS_ROUTER_LISTEN /
# SEBAS_FEISHU_APP_ID / SEBAS_FEISHU_APP_SECRET / SEBAS_LOG_LEVEL
