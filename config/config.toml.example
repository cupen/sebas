# 飞书机器人接入。app_id / app_secret 必填，或由 env 覆盖。
[feishu]
app_id = ""
app_secret = ""

# 单用户鉴权：填你的 open_id（ou_ 开头），只允许该用户驱动 bot。
# 留空 = 不过滤发送者（任何能私聊 bot 的用户都可驱动本机 claude），启动时会有 warn。
# 强烈建议填上；open_id 可在飞书开放平台或 bot 收到的消息事件里查到。
# owner_id = "ou_xxx"
#
# 启动时发给每个恢复会话的消息（空 = 不发）
# hello_msg = "你好，我又回来了"
#
# env 覆盖（优先级高于本文件）：SEBAS_FEISHU_APP_ID / SEBAS_FEISHU_APP_SECRET / SEBAS_LOG_LEVEL


# Claude Code 接入：sebas 直接以 stream-json + control protocol 拉起 `claude` CLI。
# path 支持 PATH 查找；args 为附加 CLI 参数。
[acp.claude]
path = "claude"
args = []


# 卡片流配置（全部可选，默认值见 docs/superpowers/specs/2026-07-26-sebas-design.md §6.2）
# [card]
# max_user_text_chars = 4000    # 单元素文本软上限，超过则截断 + 灰注
# max_tool_output_chars = 0     # 0 = 不输出 tool call 结果内容（默认）；>0 时超过则折叠进工具面板
# fold_long_output = true       # true：tool call 折叠成可收起面板；false：内联全文
# thinking = "show"             # 模型思考内容的卡片展示：show（折叠面板，默认）/ hide（不渲染）


# LLM provider 网关（Anthropic/OpenAI 双协议面纯透传）。完整说明见
# docs/superpowers/specs/2026-08-06-gateway-design.md。
#
# 运行方式：
#   sebas gateway -c <path>    独立进程，listen 用下面配置（--config 等价）
#   sebas run --gateway        随主服务启动，随机端口（127.0.0.1:0），真实端口
#                              输出到日志；把 ANTHROPIC_BASE_URL / OPENAI_BASE_URL
#                              指向 http://127.0.0.1:<port> 即可接入
#
# provider 统一写在顶层 [provider.<name>]（唯一写法，run 与 gateway 共用）：
# 名称即 preset——anthropic / openai / deepseek / kimi / glm / minimax / ark /
# dashscope / gemini 自带 protocol / base_url / api_key_env 默认值，显式字段覆盖；
# 双协议 provider（deepseek/kimi/glm/minimax/ark）必须显式 protocol，不猜。
#
# debug 模式：sebas gateway --debug（或 run --gateway --debug），parse 后注入内置
# test provider（model=test，gateway 自身应答固定文字 + 回显输入，不拨号上游）；
# 同时跳过下游鉴权，key 可留空/不配置。
#
# Claude Code 接入提示：/model 选择器会请求 GET /v1/models（无 model 的请求），
# 需要配 default_provider 兜底，否则返回 502 no_route。
# [gateway]
# default_provider = "deepseek"
# listen = "127.0.0.1:8787"     # run --gateway 忽略此值（强制随机端口）
# max_body_bytes = 67_108_864
# connect_timeout_secs = 10
# read_timeout_secs = 600
# usage_file = "~/.sebas/gateway-usage.jsonl"
#
# env 覆盖（优先级高于本文件）：SEBAS_GATEWAY_LISTEN
#
# # 下游客户端 token（鉴权用；单个字符串或数组）
# # 不配置 = 不校验 token（裸奔，启动时 warn）
# auth_token = ["sk-local-dev"]
#
#
# # 单行即用：protocol / base_url / api_key_env 由 preset 自动填充
# [provider.anthropic]
# # api_key = "..."                   # 明文仅测试用（启动时 warn）
# # model_map = { "claude-3.5-sonnet" = "claude-3-5-sonnet-20241022" }
#
#
# # 双协议 preset 必须显式 protocol
# [provider.deepseek]
# protocol = "anthropic"
# # base_url = "https://api.deepseek.com/anthropic"   # 自动填充，可覆盖
# # api_key_env = "DEEPSEEK_API_KEY"                   # 自动填充，可覆盖
#
#
# # 路由表：model（可含 glob）→ provider 数组，数组顺序 = 优先级（先 = 主）。
# # glob 键需加引号；故障转移（主失败自动切换）暂未实现。
# [gateway.routes]
# "claude-*" = ["anthropic"]
# "deepseek-*" = ["deepseek", "ark"]
