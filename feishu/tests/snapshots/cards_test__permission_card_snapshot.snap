---
source: feishu/tests/cards_test.rs
expression: card
---
schema: "2.0"
header:
  title:
    content: ⚠ 权限请求
    tag: plain_text
  template: orange
body:
  elements:
    - tag: markdown
      content: "**Bash** 想要执行："
    - tag: markdown
      content: "```json\n{\n  \"cmd\": \"rm -rf\"\n}\n```"
    - tag: div
      text:
        tag: plain_text
        content: 相同调用 = 工具名和参数完全一致；仅当前会话有效，/new 后失效
        text_size: notation
        text_color: grey
    - tag: button
      text:
        tag: plain_text
        content: 本次允许
      type: primary
      behaviors:
        - type: callback
          value:
            decision: allow_once
            request_id: r1
            session_id: s1
    - tag: button
      text:
        tag: plain_text
        content: 相同调用不再询问
      type: default
      behaviors:
        - type: callback
          value:
            decision: allow_session
            request_id: r1
            session_id: s1
    - tag: button
      text:
        tag: plain_text
        content: 拒绝
      type: danger
      behaviors:
        - type: callback
          value:
            decision: deny
            request_id: r1
            session_id: s1
