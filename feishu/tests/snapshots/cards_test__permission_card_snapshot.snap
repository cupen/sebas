---
source: feishu/tests/cards_test.rs
expression: card
---
schema: "2.0"
header:
  title:
    content: ⚠ 权限请求
    tag: plain_text
  template: orange
body:
  elements:
    - tag: markdown
      content: "**Bash** 想要执行："
    - tag: markdown
      content: "```json\n{\n  \"cmd\": \"rm -rf\"\n}\n```"
    - tag: div
      text:
        tag: plain_text
        content: Allow once = 这一次 · Allow session = 本会话同签名全部 · Deny = 拒绝
        text_size: notation
        text_color: grey
    - tag: actions
      actions:
        - text:
            tag: plain_text
            content: Allow once
          type: primary
          behaviors:
            - type: callback
              value:
                session_id: s1
                request_id: r1
                decision: allow_once
        - text:
            tag: plain_text
            content: Allow session
          type: default
          behaviors:
            - type: callback
              value:
                session_id: s1
                request_id: r1
                decision: allow_session
        - text:
            tag: plain_text
            content: Deny
          type: danger
          behaviors:
            - type: callback
              value:
                session_id: s1
                request_id: r1
                decision: deny
